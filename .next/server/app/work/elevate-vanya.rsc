5:["$","$L10",null,{"project":{"slug":"elevate-vanya","categoryNumber":"03","categoryTitle":"Real Estate Campaigns","brand":"Elevate Vanya","tagline":"Omnichannel Launch · Highway Hoardings & On-Site Roll-up Standees","year":"2024","role":"Large-Format Print Collateral, Vector Masters, Social Systems","challengeParagraph":"Elevate Vanya required the same campaign to work across physical and digital marketing environments — a 24×12-foot highway hoarding, on-site roll-up standees, social content, blog graphics, and motion reels. The challenge was translating the residential campaign into formats with very different viewing conditions, from large-scale outdoor communication to detailed mobile content.","projectGoal":"Ensure seamless campaign continuity between high-speed highway billboard viewing, physical on-site sales exhibitions, and handheld mobile feeds.","designDecision":"Engineered vector print assets at full production scale (402 MB vector standee master) with high-contrast hierarchical typography that remains legible at both 50 meters and 50 centimeters.","heroImage":{"jpg":"/work/elevate-vanya/elevate-vanya_hero_01.jpg","webp":"/work/elevate-vanya/elevate-vanya_hero_01.webp","alt":"Elevate Vanya On-Site Roll-Up Standee Master by Kashish"},"supportingImages":[{"id":"elevate_standee_02","title":"2:1 Exhibition Roll-up Standee S-2","format":"Print / Exhibition Collateral","jpg":"/work/elevate-vanya/elevate-vanya_standee_02.jpg","webp":"/work/elevate-vanya/elevate-vanya_standee_02.webp","alt":"Elevate Vanya 2:1 Ratio Exhibition Standee","authorship":"Designed by Kashish"},{"id":"elevate_support_02","title":"Golden Hour Architecture & Greenery","format":"Multi-Tile Social Grid","jpg":"/work/elevate-vanya/elevate-vanya_support_02.jpg","webp":"/work/elevate-vanya/elevate-vanya_support_02.webp","alt":"Elevate Vanya Golden Hour Architectural Rendering"},{"id":"elevate_blog_01","title":"Editorial Blog & Thought Leadership Banner","format":"Digital Editorial","jpg":"/work/elevate-vanya/elevate-vanya_blog_01.jpg","webp":"/work/elevate-vanya/elevate-vanya_blog_01.webp","alt":"Elevate Vanya Editorial Blog Banner"}],"stats":{"deliverables":142,"campaigns":4,"timeline":"July–September 2024"}},"nextSlug":"soul","nextProject":{"slug":"soul","categoryNumber":"03","categoryTitle":"Real Estate Campaigns","brand":"Soul / Vankriti","tagline":"Biophilic Forest Living & Channel Partner B2B Acquisition","year":"2024","role":"12K Panoramic Grid, Direct Nurture EDMs, CP Acquisition","challengeParagraph":"Soul/Vankriti's campaign required an immersive biophilic visual identity for an eco-luxury forest living development — spanning a 12K panoramic multi-tile Instagram grid, seven direct client nurture EDMs, channel partner acquisition collateral, and motion walkthrough reels. The challenge was translating the tranquil, natural atmosphere of the forest setting into mobile-first formats and high-volume direct-response communications while maintaining refined editorial restraint.","projectGoal":"Engage both institutional channel partner brokers and high-net-worth nature enthusiasts through botanical tranquility and clear commission structures.","designDecision":"Built a seamless 12,960×5,400 panoramic Instagram grid as the visual centerpiece, complemented by structured WhatsApp EDMs using deep forest greens, subtle champagne rules, and video walkthroughs.","heroImage":{"jpg":"/work/soul/soul_hero_01.jpg","webp":"/work/soul/soul_hero_01.webp","alt":"Soul / Vankriti 12K Panoramic Eco-Luxury Forest Living Grid"},"supportingImages":[{"id":"soul_edm_01","title":"August Nurture EDM 01 — Forest Escape","format":"EDM / Direct Response","jpg":"/work/soul/soul_edm_01.jpg","webp":"/work/soul/soul_edm_01.webp","alt":"Soul Vankriti August Client Nurture EDM 01"},{"id":"soul_cp_01","title":"Channel Partner B2B Acquisition Creative","format":"B2B Marketing Collateral","jpg":"/work/soul/soul_cp_01.jpg","webp":"/work/soul/soul_cp_01.webp","alt":"Soul Channel Partner B2B Network Growth Creative"},{"id":"soul_festive_01","title":"Cultural & Topical Brand Identity","format":"Festive Social Post","jpg":"/work/soul/soul_festive_01.jpg","webp":"/work/soul/soul_festive_01.webp","alt":"Soul Vankriti Cultural Celebration Graphic"},{"id":"soul_grid_02","title":"Botanical Canopy & Architecture Grid","format":"Multi-Tile Social Grid","jpg":"/work/soul/soul_grid_02.jpg","webp":"/work/soul/soul_grid_02.webp","alt":"Soul Canopy Architectural Grid Detail"}],"stats":{"deliverables":275,"campaigns":4,"timeline":"July–August 2024"}}}]
