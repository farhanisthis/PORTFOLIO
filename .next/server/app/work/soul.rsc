5:["$","$L10",null,{"project":{"slug":"soul","categoryNumber":"03","categoryTitle":"Real Estate Campaigns","brand":"Soul / Vankriti","tagline":"Biophilic Forest Living & Channel Partner B2B Acquisition","year":"2024","role":"12K Panoramic Grid, Direct Nurture EDMs, CP Acquisition","challengeParagraph":"Soul/Vankriti's campaign required an immersive biophilic visual identity for an eco-luxury forest living development — spanning a 12K panoramic multi-tile Instagram grid, seven direct client nurture EDMs, channel partner acquisition collateral, and motion walkthrough reels. The challenge was translating the tranquil, natural atmosphere of the forest setting into mobile-first formats and high-volume direct-response communications while maintaining refined editorial restraint.","projectGoal":"Engage both institutional channel partner brokers and high-net-worth nature enthusiasts through botanical tranquility and clear commission structures.","designDecision":"Built a seamless 12,960×5,400 panoramic Instagram grid as the visual centerpiece, complemented by structured WhatsApp EDMs using deep forest greens, subtle champagne rules, and video walkthroughs.","heroImage":{"jpg":"/work/soul/soul_hero_01.jpg","webp":"/work/soul/soul_hero_01.webp","alt":"Soul / Vankriti 12K Panoramic Eco-Luxury Forest Living Grid"},"supportingImages":[{"id":"soul_edm_01","title":"August Nurture EDM 01 — Forest Escape","format":"EDM / Direct Response","jpg":"/work/soul/soul_edm_01.jpg","webp":"/work/soul/soul_edm_01.webp","alt":"Soul Vankriti August Client Nurture EDM 01"},{"id":"soul_cp_01","title":"Channel Partner B2B Acquisition Creative","format":"B2B Marketing Collateral","jpg":"/work/soul/soul_cp_01.jpg","webp":"/work/soul/soul_cp_01.webp","alt":"Soul Channel Partner B2B Network Growth Creative"},{"id":"soul_festive_01","title":"Cultural & Topical Brand Identity","format":"Festive Social Post","jpg":"/work/soul/soul_festive_01.jpg","webp":"/work/soul/soul_festive_01.webp","alt":"Soul Vankriti Cultural Celebration Graphic"},{"id":"soul_grid_02","title":"Botanical Canopy & Architecture Grid","format":"Multi-Tile Social Grid","jpg":"/work/soul/soul_grid_02.jpg","webp":"/work/soul/soul_grid_02.webp","alt":"Soul Canopy Architectural Grid Detail"}],"stats":{"deliverables":275,"campaigns":4,"timeline":"July–August 2024"}},"nextSlug":"kreeva","nextProject":{"slug":"kreeva","categoryNumber":"01","categoryTitle":"Luxury & Bespoke","brand":"Kreeva","tagline":"Artisanal Luxury Narrative & Tactile Print Collateral","year":"2024","role":"Visual Identity, Editorial Typography, Tactile Stationery & EDMs","accentColor":"#8B1E2B","challengeParagraph":"Kreeva's work called for a more restrained and tactile luxury language — a multi-part Friendship Day narrative combined with corporate stationery and collateral, requiring the same visual character to work across vertical digital storytelling and physical print. The challenge was communicating an idea around enduring connection through minimal composition, rich texture, editorial typography, and carefully constructed physical details.","projectGoal":"Establish an understated, tactile luxury language for an artisanal brand narrative spanning digital social storytelling and physical stationery.","designDecision":"Utilized textured crimson paper surfaces, gold foil geometric rules, and classical editorial serif type. For physical envelopes and cards, engineered precise folding geometry and embossed brand marks.","heroImage":{"jpg":"/work/kreeva/kreeva_hero_01.jpg","webp":"/work/kreeva/kreeva_hero_01.webp","alt":"Kreeva Luxury Narrative Cover with Crimson and Gold Editorial Framing"},"supportingImages":[{"id":"kreeva_swaranaya_01","title":"Swaranaya Static EDM Suite","format":"EDM / Direct Response","jpg":"/work/kreeva/kreeva_swaranaya_01.jpg","webp":"/work/kreeva/kreeva_swaranaya_01.webp","alt":"Kreeva Swaranaya Static EDM designed by Kashish","authorship":"Designed by Kashish"},{"id":"kreeva_envelope_01","title":"Corporate Stationery Envelope Mockup","format":"Print & Stationery","jpg":"/work/kreeva/kreeva_envelope_01.jpg","webp":"/work/kreeva/kreeva_envelope_01.webp","alt":"Kreeva Corporate Stationery Envelope with Gold Foil Emboss","authorship":"Designed by Kashish"},{"id":"kreeva_card_01","title":"Tactile Invitation Card (Front)","format":"Print & Stationery","jpg":"/work/kreeva/kreeva_card_01.jpg","webp":"/work/kreeva/kreeva_card_01.webp","alt":"Kreeva Foil-Stamped Invitation Card Front Design"},{"id":"kreeva_card_02","title":"Tactile Invitation Card (Reverse)","format":"Print & Stationery","jpg":"/work/kreeva/kreeva_card_02.jpg","webp":"/work/kreeva/kreeva_card_02.webp","alt":"Kreeva Invitation Card Reverse Typography Layout"},{"id":"kreeva_support_01","title":"Friendship Day Narrative — Chapter 3","format":"Editorial Social Story","jpg":"/work/kreeva/kreeva_support_01.jpg","webp":"/work/kreeva/kreeva_support_01.webp","alt":"Kreeva Friendship Day Editorial Social Story"},{"id":"kreeva_support_02","title":"Friendship Day Narrative — Chapter 4","format":"Editorial Social Story","jpg":"/work/kreeva/kreeva_support_02.jpg","webp":"/work/kreeva/kreeva_support_02.webp","alt":"Kreeva Friendship Day Story Finale Layout"}],"stats":{"deliverables":184,"campaigns":4,"timeline":"July–August 2024"}}}]
