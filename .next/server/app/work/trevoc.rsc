5:["$","$L10",null,{"project":{"slug":"trevoc","categoryNumber":"02","categoryTitle":"Ultra-Luxury Real Estate","brand":"Trevoc","tagline":"Sector-56 Gurugram · OTT-Inspired Teaser Velocity & Panoramic Grids","year":"2024","role":"Campaign Systems, SVS Grids, EDMs & Teaser Creative Direction","challengeParagraph":"Trevoc's campaign needed to communicate an ultra-luxury real estate proposition through a digital presence that felt more distinctive than conventional property advertising — spanning celebrity-led communication, digital headers, panoramic social grids, and an OTT-inspired teaser series. The challenge was maintaining one consistent luxury identity while adapting across very different digital formats and moments of communication.","projectGoal":"Differentiate Sector-56 Gurugram residence from standard builder ads by using streaming-platform entertainment cues and quiet architectural luxury.","designDecision":"Employed an 'Art of Stillness' motif with widescreen 2.4:1 ratio grids, rich monochrome transitions, high-contrast serif typography, and an OTT headline trope ('Brochures Are Retiring').","heroImage":{"jpg":"/work/trevoc/trevoc_hero_01.jpg","webp":"/work/trevoc/trevoc_hero_01.webp","alt":"Trevoc Sector 56 Gurugram Art of Stillness Panoramic Luxury Grid"},"supportingImages":[{"id":"trevoc_support_01","title":"OTT Teaser: 'Brochures Are Retiring'","format":"Campaign Teaser","jpg":"/work/trevoc/trevoc_support_01.jpg","webp":"/work/trevoc/trevoc_support_01.webp","alt":"Trevoc OTT Teaser Brochures Are Retiring in Dark Architectural Framing"},{"id":"trevoc_support_02","title":"OTT Teaser: 'Walkthroughs Are Retiring'","format":"Campaign Teaser","jpg":"/work/trevoc/trevoc_support_02.jpg","webp":"/work/trevoc/trevoc_support_02.webp","alt":"Trevoc OTT Teaser Walkthroughs Are Retiring Widescreen Layout"},{"id":"trevoc_support_03","title":"OTT Teaser: 'Print Ads Are Retiring'","format":"Campaign Teaser","jpg":"/work/trevoc/trevoc_support_03.jpg","webp":"/work/trevoc/trevoc_support_03.webp","alt":"Trevoc OTT Teaser Print Ads Are Retiring"},{"id":"trevoc_celebrity_banner","title":"Celebrity Brand Ambassador Campaign","format":"Digital Banner / High-Stakes Commercial","jpg":"/work/trevoc/trevoc_celebrity_banner.jpg","webp":"/work/trevoc/trevoc_celebrity_banner.webp","alt":"Trevoc Celebrity Brand Campaign (Private — permission pending)","isRestricted":true},{"id":"trevoc_hr_01","title":"Internal Corporate & Team Communication","format":"Corporate / HR","jpg":"/work/trevoc/trevoc_hr_01.jpg","webp":"/work/trevoc/trevoc_hr_01.webp","alt":"Trevoc Internal HR Communication (Private — permission pending)","isRestricted":true}],"stats":{"deliverables":590,"campaigns":8,"timeline":"June–September 2024"}},"nextSlug":"indus-valley","nextProject":{"slug":"indus-valley","categoryNumber":"03","categoryTitle":"Real Estate Campaigns","brand":"Indus Valley","tagline":"Himalayan Hill Cottages & Infrastructure Investment Communications","year":"2024","role":"Market-News EDMs, Investment Infographics & Multi-Tile Grids","challengeParagraph":"Indus Valley's campaign required a consistent visual system for communicating its Himalayan real estate offering across frequent investment-focused marketing communications — market-news and investment EDMs, motion graphics, Himalayan villa and cottage campaigns, and Instagram grid covers. The challenge was keeping a recognisable visual language across a high volume of mobile-first and social formats while communicating property and investment information clearly.","projectGoal":"Communicate dual propositions: the aspirational escape of Himalayan cottage living and the institutional investment fundamentals of regional growth corridors.","designDecision":"Created an editorial news format for WhatsApp and email with route maps, infrastructure bulletins, and clear statistical callouts balanced against serene mountain photography.","heroImage":{"jpg":"/work/indus-valley/indus-valley_hero_01.jpg","webp":"/work/indus-valley/indus-valley_hero_01.webp","alt":"Indus Valley Himalayan Hill Cottages Panoramic Grid"},"supportingImages":[{"id":"indus_support_01","title":"Dholera SIR Infrastructure Intelligence EDM","format":"EDM / Direct Response","jpg":"/work/indus-valley/indus-valley_support_01.jpg","webp":"/work/indus-valley/indus-valley_support_01.webp","alt":"Indus Valley Dholera SIR Investment EDM with Economic Charts"},{"id":"indus_support_02","title":"Expressway & High-Speed Transit Route Map","format":"Infographic / Market News","jpg":"/work/indus-valley/indus-valley_support_02.jpg","webp":"/work/indus-valley/indus-valley_support_02.webp","alt":"Indus Valley Regional Infrastructure Route Map"},{"id":"indus_support_03","title":"Himalayan Villa Lifestyle Showcase","format":"Static Social Tile","jpg":"/work/indus-valley/indus-valley_support_03.jpg","webp":"/work/indus-valley/indus-valley_support_03.webp","alt":"Indus Valley Himalayan Architectural Lifestyle"}],"stats":{"deliverables":303,"campaigns":6,"timeline":"June–August 2024"}}}]
